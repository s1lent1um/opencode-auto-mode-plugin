{
  "name": "@s1lent1um/opencode-auto-mode-plugin",
  "version": "0.1.1",
  "description": "OpenCode TUI plugin: hotkey and on/off indicator for auto-approve permissions",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "permissions",
    "auto-approve"
  ],
  "license": "MIT",
  "author": "s1lent1um",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s1lent1um/opencode-auto-mode-plugin.git"
  },
  "homepage": "https://github.com/s1lent1um/opencode-auto-mode-plugin#readme",
  "type": "module",
  "exports": {
    "./tui": {
      "import": "./dist/tui.js",
      "config": {
        "keybind": "<leader>p"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "opencode": ">=1.18.0 <2"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.0",
    "@opentui/solid": ">=0.4.5",
    "solid-js": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-typescript": "^7.27.1",
    "@opencode-ai/plugin": "^1.18.32",
    "@opentui/core": "^0.4.5",
    "@opentui/keymap": "^0.4.5",
    "@opentui/solid": "^0.4.5",
    "@types/node": "^26.6.4",
    "babel-preset-solid": "^1.9.12",
    "solid-js": "^1.9.12",
    "typescript": "^5.8.2"
  }
}
